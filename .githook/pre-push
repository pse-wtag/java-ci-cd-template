#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
REMOTE="$1"

unset GIT_DIR GIT_WORK_TREE
ZERO=0000000000000000000000000000000000000000

# ── Path gating: skip unless pushed commits touch YAML files ─────────
needs_check=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    paths=$(git log --name-only --pretty=format: "$local_sha" --not --remotes="$REMOTE" 2>/dev/null || true)
  else
    paths=$(git log --name-only --pretty=format: "$remote_sha..$local_sha" 2>/dev/null || true)
  fi

  if printf '%s\n' "$paths" | grep -E '(\.yml$|\.yaml$)' >/dev/null; then
    needs_check=1
    break
  fi
done

if [ "$needs_check" -eq 0 ]; then
  echo "[pre-push] ✓ No YAML changes detected — skipping linters."
  echo "✅ pre-push successful"
  exit 0
fi

# ── CI/CD: Run YAML and Action Linters ─────────────────────────────────
echo "[pre-push] ⏳ YAML changes detected. Running linters..."
FAILED=0

# 1. Actionlint (Validates GitHub Actions logic)
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] Running actionlint..."
  if ! (cd "$ROOT" && actionlint); then
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ actionlint not installed — skipping GitHub Actions validation."
  echo "           Install with: brew install actionlint"
fi

# 2. Yamllint (Validates general YAML syntax)
if command -v yamllint >/dev/null 2>&1; then
  echo "[pre-push] Running yamllint..."
  # No -d flag: that would override the repo's .yamllint.yml. Config is
  # discovered from $ROOT so the hook and any CI run share one ruleset.
  if ! (cd "$ROOT" && yamllint --strict .); then
    FAILED=1
  fi
else
  echo "[pre-push] ⚠️ yamllint not installed — skipping general YAML validation."
  echo "           Install with: brew install yamllint"
fi

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "[pre-push] ❌ Linting failed — push blocked."
  echo "[pre-push]    Please fix the YAML errors above before pushing to GitHub."
  exit 1
fi

echo "✅ pre-push successful"